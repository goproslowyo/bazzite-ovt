@@ -141,6 +152,61 @@ DragDetWnd::~DragDetWnd()
 }
 
 
+/*
+ *-----------------------------------------------------------------------------
+ *
+ * DragDetWnd::RefreshScreenSize --
+ *
+ *    Update the uinput device after a change of screen size.
+ *
+ *    The device declares its absolute range when it is created, and
+ *    FakeMouse_Move() clamps to the size it was created with. After a
+ *    resolution change the range describes the old screen. The compositor
+ *    scales the old range onto the new output, and the clamp cuts off
+ *    coordinates beyond the old size. The GTK3 build checks the screen
+ *    size in DnDUIX11::OnSrcDragBegin() for the same reason.
+ *
+ *    This opens a fresh connection, because Xlib updates the screen size of
+ *    an open connection only for a client that processes RandR events itself.
+ *
+ * Side effects:
+ *    Recreates the uinput device if the size has changed. If that fails the
+ *    pointer goes back to XTest.
+ *
+ *-----------------------------------------------------------------------------
+ */
+
+void
+DragDetWnd::RefreshScreenSize(void)
+{
+#ifdef USE_UINPUT
+   Display *display;
+   Screen *scrn;
+
+   if (!mUseUInput) {
+      return;
+   }
+   display = XOpenDisplay(NULL);
+   if (display == NULL) {
+      return;
+   }
+   scrn = DefaultScreenOfDisplay(display);
+   if (scrn->width != mScreenWidth || scrn->height != mScreenHeight) {
+      g_debug("%s: screen is now %dx%d, was %dx%d\n", __FUNCTION__,
+              scrn->width, scrn->height, mScreenWidth, mScreenHeight);
+      if (FakeMouse_Update(scrn->width, scrn->height)) {
+         mScreenWidth = scrn->width;
+         mScreenHeight = scrn->height;
+      } else {
+         g_warning("%s: could not recreate the uinput device\n", __FUNCTION__);
+         mUseUInput = false;
+      }
+   }
+   XCloseDisplay(display);
+#endif
+}
+
+
 /**
  * Get the actual widget.
  */
@@ -984,6 +1050,10 @@ DragDetWnd::SimulateXEvents(const bool showWidget, const bool buttonEvent,
    /*
     * Generate mouse movements over the window.  The second one makes ungrabs
     * happen more reliably on KDE, but isn't necessary on GNOME.
+    *
+    * The coordinates may have come straight from the host. FakeMouse_Move()
+    * keeps them within the range of the uinput device, and the X server
+    * keeps a warp or an XTest motion on the screen.
     */
    if (mUseUInput) {
 #ifdef USE_UINPUT
diff --git a/services/plugins/dndcp/fakeMouseWayland/fakeMouseWayland.cpp b/services/plugins/dndcp/fakeMouseWayland/fakeMouseWayland.cpp
index 0311a4e..30ddfb2 100644
--- a/services/plugins/dndcp/fakeMouseWayland/fakeMouseWayland.cpp
+++ b/services/plugins/dndcp/fakeMouseWayland/fakeMouseWayland.cpp
@@ -43,6 +43,10 @@ static int uinput_fd = -1;
 // Indicates if the uinput device is created
 static bool isInit = false;
 
+// The screen the uinput device was told about, for clamping what it is given.
+static int screenWidth = 0;
+static int screenHeight = 0;
+
 /*
  *-----------------------------------------------------------------------------
  *
@@ -98,6 +102,8 @@ FakeMouse_Init(int fd,       // fd for uinput
    if (uinput_fd == -1) {
       return false;
    }
+   screenWidth = width;
+   screenHeight = height;
 
    /*
     * The uinput old interface is used for compatibility.
@@ -141,6 +147,26 @@ FakeMouse_Init(int fd,       // fd for uinput
       g_debug("%s: Failed to register UI_SET_KEYBIT BTN_LEFT\n", __FUNCTION__);
       goto exit;
    }
+
+   /*
+    * Without an INPUT_PROP_* bit, udev and libinput cannot tell what kind of
+    * device this is. The kernel also exposes it as a joystick:
+    *   N: Name="VMware DnD UInput pointer"
+    *   H: Handlers=mouse4 event7 js1
+    *   B: PROP=0
+    * libinput then misclassifies it, and that has broken other pointer
+    * features, such as the side buttons on a real mouse. The device reports
+    * absolute coordinates over the whole screen, so declare it a direct
+    * pointing device.
+    */
+   if (ioctl(uinput_fd, UI_SET_PROPBIT, INPUT_PROP_DIRECT) < 0) {
+      g_debug("%s: Failed to register UI_SET_PROPBIT INPUT_PROP_DIRECT\n",
+              __FUNCTION__);
+   }
+   if (ioctl(uinput_fd, UI_SET_PROPBIT, INPUT_PROP_POINTER) < 0) {
+      g_debug("%s: Failed to register UI_SET_PROPBIT INPUT_PROP_POINTER\n",
+              __FUNCTION__);
+   }
    if (ioctl(uinput_fd, UI_DEV_CREATE, 0) < 0) {
       g_debug("%s: Failed to create UInput device\n", __FUNCTION__);
       goto exit;
@@ -250,6 +276,23 @@ FakeMouse_Move(int x,    // IN
    bool retValue = true;
    struct input_event event;
 
+   /*
+    * The coordinates can come straight from the host, and every uinput move
+    * comes through here. The device was declared with this range, and a
+    * compositor may do anything with a value outside it.
+    */
+   if (screenWidth > 0 && screenHeight > 0) {
+      int clampedX = MIN(MAX(x, 0), screenWidth - 1);
+      int clampedY = MIN(MAX(y, 0), screenHeight - 1);
+
+      if (clampedX != x || clampedY != y) {
+         g_debug("%s: clamping (%d, %d) to (%d, %d)\n", __FUNCTION__,
+                 x, y, clampedX, clampedY);
+         x = clampedX;
+         y = clampedY;
+      }
+   }
+
    event.type = EV_ABS;
    event.code = ABS_X;
    event.value = x;
