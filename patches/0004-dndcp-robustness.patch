From: GoProSlowYo <68455785+goproslowyo@users.noreply.github.com>
Date: Tue, 22 Sep 2026 21:29:21 -0700
Subject: [PATCH 4/6] dndcp: survive a missing X display, and never leave the
 button down

XOpenDisplay() can return NULL and the uinput setup used the result without
checking, so the daemon died while registering drag and drop rather than
falling back to XTest. A compositor that starts Xwayland on demand and stops
it once the last client goes makes that reachable; sway does.

A press is faked through uinput to start a host to guest drag, and the host
releases it when it drops. If the drag never starts there is no drop and no
release, and a button left down holds the pointer in a drag for the rest of
the session, which to the user looks like the desktop has frozen. Release it
when the UI is reset.
---
 .../plugins/dndcp/dndGuestBase/dndUIX11GTK4.h |  2 ++
 services/plugins/dndcp/dndUIX11GTK4.cpp       | 18 +++++++++++++
 services/plugins/dndcp/dragDetWndX11GTK4.cpp  | 27 +++++++++++++------
 3 files changed, 39 insertions(+), 8 deletions(-)

diff --git a/services/plugins/dndcp/dndGuestBase/dndUIX11GTK4.h b/services/plugins/dndcp/dndGuestBase/dndUIX11GTK4.h
index 4396701..c0d786d 100644
--- a/services/plugins/dndcp/dndGuestBase/dndUIX11GTK4.h
+++ b/services/plugins/dndcp/dndGuestBase/dndUIX11GTK4.h
@@ -208,6 +208,8 @@ private:
    bool mInHGDrag;
    // Flag to indicate if H->G drag has been triggered in guest by simulate mouse press
    bool mHGDragStarted;
+   /* A faked press is outstanding; it must not outlive the drag. */
+   bool mHGButtonDown;
    DND_DROPEFFECT mEffect;
    int32 mMousePosX;
    int32 mMousePosY;
diff --git a/services/plugins/dndcp/dndUIX11GTK4.cpp b/services/plugins/dndcp/dndUIX11GTK4.cpp
index 942f7b3..494d67e 100644
--- a/services/plugins/dndcp/dndUIX11GTK4.cpp
+++ b/services/plugins/dndcp/dndUIX11GTK4.cpp
@@ -79,6 +79,7 @@ DnDUIX11::DnDUIX11(ToolsAppCtx *ctx)
       mGHReadCancel(NULL),
       mGHReads(NULL),
       mInHGDrag(false),
+      mHGButtonDown(false),
       mEffect(DROP_NONE),
       mMousePosX(0),
       mMousePosY(0),
@@ -255,6 +256,18 @@ void
 DnDUIX11::ResetUI()
 {
    TRACE_CALL();
+   /*
+    * The press faked to start a host to guest drag is released by the host
+    * when it drops. If the drag never started there is nothing to drop, and
+    * a button left down through uinput holds the pointer in a drag for the
+    * whole session, which looks to the user like the desktop has frozen.
+    */
+   if (mHGButtonDown) {
+      g_debug("%s: releasing the faked button\n", __FUNCTION__);
+      mDetWnd->SimulateXEvents(false, true, false, true, false,
+                               mMousePosX, mMousePosY);
+      mHGButtonDown = false;
+   }
    mGHDnDDataReceived = false;
    mHGGetFileStatus = DND_FILE_TRANSFER_NOT_STARTED;
    mGHDnDInProgress = false;
@@ -723,6 +736,7 @@ DnDUIX11::OnMoveMouse(int32 x,  // IN: Pointer x-coord
          mDetWnd->SimulateXEvents(true, true, false, true, true, pressX, pressY);
          // simulate drag mouse press
          mDetWnd->SimulateXEvents(false, true, true, false, true, pressX, pressY);
+         mHGButtonDown = true;
          // Tell Gtk that a drag should be started from this widget.
          mDetWnd->StartDrag(mProvider, pressX, pressY);
 
@@ -779,6 +793,8 @@ DnDUIX11::OnSrcCancel()
    ShowDetWnd(false, 0, 0, DET_WND_DRAG_SOURCE);
    mDetWnd->SimulateXEvents(false, false, false, false, true,
                            mMousePosX, mMousePosY);
+   /* The real release has been sent; ResetUI() need not send another. */
+   mHGButtonDown = false;
    mInHGDrag = false;
    mHGGetFileStatus = DND_FILE_TRANSFER_NOT_STARTED;
    mEffect = DROP_NONE;
@@ -890,6 +906,8 @@ DnDUIX11::OnSrcDrop()
     */
    mDetWnd->SimulateXEvents(false, true, false, false, true,
                             mMousePosX, mMousePosY);
+   /* The real release has been sent; ResetUI() need not send another. */
+   mHGButtonDown = false;
    ShowDetWnd(false, 0, 0, DET_WND_DRAG_SOURCE);
    /* We've successful or failure for HG drag, set the flag to false anyway */
    mInHGDrag = false;
diff --git a/services/plugins/dndcp/dragDetWndX11GTK4.cpp b/services/plugins/dndcp/dragDetWndX11GTK4.cpp
index 95f602b..fc443c6 100644
--- a/services/plugins/dndcp/dragDetWndX11GTK4.cpp
+++ b/services/plugins/dndcp/dragDetWndX11GTK4.cpp
@@ -122,15 +122,26 @@ DragDetWnd::DragDetWnd(int useUInput_fd)
    if (useUInput_fd != -1) {
        g_debug("%s: Using uinput simulation", __FUNCTION__);
        Display *display = XOpenDisplay(NULL);
-       Screen * scrn = DefaultScreenOfDisplay(display);
-       if (FakeMouse_Init(useUInput_fd, scrn->width, scrn->height)) {
-           mUseUInput = true;
-           mScreenWidth = scrn->width;
-           mScreenHeight = scrn->height;
-           g_debug("%s: mScreenWidth is %d, mScreenHeight is %d", __FUNCTION__, mScreenWidth, mScreenHeight);
+
+       /*
+        * A compositor may start Xwayland on demand and stop it again when
+        * the last client goes, so there is not always a server to ask. The
+        * pointer then moves through XTest instead, which needs no screen
+        * size from here.
+        */
+       if (display != NULL) {
+           Screen * scrn = DefaultScreenOfDisplay(display);
+           if (FakeMouse_Init(useUInput_fd, scrn->width, scrn->height)) {
+               mUseUInput = true;
+               mScreenWidth = scrn->width;
+               mScreenHeight = scrn->height;
+               g_debug("%s: mScreenWidth is %d, mScreenHeight is %d", __FUNCTION__, mScreenWidth, mScreenHeight);
+           }
+           // Disconnect the connection to X Server.
+           XCloseDisplay(display);
+       } else {
+           g_warning("%s: no X display, uinput disabled\n", __FUNCTION__);
        }
-       // Disconnect the connection to X Server.
-       XCloseDisplay(display);
    }
 #endif
    return;
