+                  }
+                  mDetWnd->SimulateXEvents(false, false, false, false, true,
+                                           tx, ty);
+                  /* SimulateXEvents() ends a pixel down and right. */
+                  over = mDetWnd->PointerIsOver(tx + 1, ty + 1);
+                  if (over) {
