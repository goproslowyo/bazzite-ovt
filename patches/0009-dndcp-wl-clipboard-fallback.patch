+/*
+ *-----------------------------------------------------------------------------
+ *
+ * CopyPasteWaylandRunPaste --
+ *
+ *    Run wl-paste and collect its stdout within the request deadline and the
+ *    V3 size ceiling.
+ *
+ *    The data comes from whichever client owns the selection, through
+ *    wl-paste, at that client's pace. This runs on the main loop that also
+ *    carries the RPC channel, so an owner that never writes, or never stops
+ *    writing, must not hold it. The pipe is polled against the deadline, and
+ *    wl-paste is killed at the deadline or at the ceiling.
+ *
+ * Results:
+ *    A NUL terminated buffer, to be freed with g_free(), holding *outLen
+ *    bytes before the terminator. NULL when wl-paste failed, exited non-zero,
+ *    ran out of time or produced too much. wl-paste exits non-zero for an
+ *    empty clipboard.
+ *
+ *-----------------------------------------------------------------------------
+ */
+
+static guchar *
+CopyPasteWaylandRunPaste(const gchar *const *argv,  // IN
+                         gint64 deadline,           // IN: monotonic, us
+                         gsize *outLen)             // OUT
+{
+   GPid pid = 0;
+   gint stdoutFd = -1;
+   GError *err = NULL;
+   GByteArray *acc;
+   guchar chunk[65536];
+   gint status = 0;
+   pid_t waited;
+   bool complete = false;
+
+   *outLen = 0;
+
+   if (!g_spawn_async_with_pipes(NULL, (gchar **) argv, NULL,
+            (GSpawnFlags) (G_SPAWN_SEARCH_PATH | G_SPAWN_DO_NOT_REAP_CHILD),
+            CopyPasteWaylandChildSetup, NULL,
+            &pid, NULL, &stdoutFd, NULL, &err)) {
+      g_debug("%s: failed to spawn wl-paste: %s\n", __FUNCTION__,
+              err != NULL ? err->message : "unknown error");
+      g_clear_error(&err);
+      return NULL;
+   }
+
+   if (!g_unix_set_fd_nonblocking(stdoutFd, TRUE, NULL)) {
+      g_debug("%s: could not make the pipe non-blocking\n", __FUNCTION__);
+   }
+
+   acc = g_byte_array_new();
+
+   for (;;) {
+      ssize_t got = read(stdoutFd, chunk, sizeof chunk);
+
+      if (got > 0) {
+         /* The host refuses anything past the ceiling, so stop there. */
+         if ((gsize) acc->len + (gsize) got > (gsize) CPCLIPITEM_MAX_SIZE_V3) {
+            g_debug("%s: %s output exceeds the V3 limit, dropping\n",
+                    __FUNCTION__, argv[0]);
+            break;
+         }
+         g_byte_array_append(acc, chunk, (guint) got);
+         continue;
+      }
+      if (got == 0) {
+         complete = true;
+         break;
+      }
+      if (errno == EINTR) {
+         continue;
+      }
+      if (errno != EAGAIN) {
+         g_warning("%s: read from %s failed: %s\n", __FUNCTION__, argv[0],
+                   g_strerror(errno));
+         break;
+      }
+
+      unsigned int left = CopyPasteWaylandRemainingMs(deadline);
+      if (left == 0) {
+         g_debug("%s: %s did not finish in time\n", __FUNCTION__, argv[0]);
+         break;
+      }
+
+      struct pollfd pfd;
+      pfd.fd = stdoutFd;
+      pfd.events = POLLIN;
+      pfd.revents = 0;
+      poll(&pfd, 1, (int) MIN(left, (unsigned int) G_MAXINT));
+   }
+
+   close(stdoutFd);
+
+   /* SIGKILL, because the child may be blocked on a pipe either way. */
+   if (!complete) {
+      kill(-pid, SIGKILL);
+      kill(pid, SIGKILL);
+   }
+
+   /*
+    * A closed stdout normally means wl-paste is exiting. Wait for it only
+    * until the deadline.
+    */
+   for (;;) {
+      waited = waitpid(pid, &status, complete ? WNOHANG : 0);
+      if (waited == pid) {
+         break;
+      }
+      if (waited < 0) {
+         if (errno == EINTR) {
+            continue;
+         }
+         break;
+      }
+      if (CopyPasteWaylandRemainingMs(deadline) == 0) {
+         g_debug("%s: %s did not exit in time\n", __FUNCTION__, argv[0]);
+         complete = false;
+         kill(-pid, SIGKILL);
+         kill(pid, SIGKILL);
+         continue;
+      }
+      g_usleep(1000);
+   }
+   g_spawn_close_pid(pid);
+
+   if (!complete || waited != pid ||
+       !WIFEXITED(status) || WEXITSTATUS(status) != 0) {
+      g_byte_array_free(acc, TRUE);
+      return NULL;
+   }
+
+   *outLen = (gsize) acc->len;
+   g_byte_array_append(acc, (const guint8 *) "", 1);
+   return g_byte_array_free(acc, FALSE);
+}
+
