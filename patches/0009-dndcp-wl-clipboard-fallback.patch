@@ -79,6 +101,291 @@ CopyPasteWaylandRemainingMs(gint64 deadline)   // IN: monotonic, microseconds
 }
 
 
+/*
+ *-----------------------------------------------------------------------------
+ *
+ * CopyPasteWaylandChildSetup --
+ *
+ *    Runs in the forked child before exec. wl-paste forks a helper of its own
+ *    to copy the data, and wl-copy forks the process that serves the
+ *    selection. A timeout has to kill both processes of the pair. A process
+ *    group of their own lets one kill() reach them.
+ *
+ *-----------------------------------------------------------------------------
+ */
+
+static void
+CopyPasteWaylandChildSetup(gpointer data)  // IN: unused
+{
+   setpgid(0, 0);
+}
+
+
+/*
+ *-----------------------------------------------------------------------------
+ *
+ * CopyPasteWaylandSetData --
+ *
+ *    Install data of type mimeType as the local Wayland selection through
+ *    wl-copy.
+ *
+ *    Spawn wl-copy and feed the bytes to its stdin. wl-copy reads stdin
+ *    until EOF, installs the selection, then forks a resident process to
+ *    serve it and exits. Wait for that exit so that a later clipboard read
+ *    cannot race the selection update. The spawn inherits the environment so
+ *    wl-copy sees WAYLAND_DISPLAY and XDG_RUNTIME_DIR.
+ *
+ *    On GNOME, wl-copy maps a window and waits for it to be given the focus,
+ *    which may never happen, for example behind the lock screen. The wait
+ *    runs on the main loop that also carries the RPC channel, so it ends
+ *    after CP_WLCOPY_TIMEOUT_MS, and wl-copy is killed then.
+ *
+ * Results:
+ *    true if the selection was installed.
+ *
+ *-----------------------------------------------------------------------------
+ */
+
+static bool
+CopyPasteWaylandSetData(const gchar *mimeType,  // IN
+                        const char *data,       // IN
+                        gsize len)              // IN
+{
+   const gchar *argv[] = { "wl-copy", "--type", mimeType, NULL };
+
+   if (!gHaveWlCopy) {
+      g_debug("%s: wl-copy is not installed\n", __FUNCTION__);
+      return false;
+   }
+
+   gint64 deadline = g_get_monotonic_time() + CP_WLCOPY_TIMEOUT_MS * 1000;
+   GPid pid = 0;
+   gint stdinFd = -1;
+   GError *err = NULL;
+   gsize off = 0;
+
+   if (!g_spawn_async_with_pipes(NULL, (gchar **) argv, NULL,
+            (GSpawnFlags) (G_SPAWN_SEARCH_PATH | G_SPAWN_DO_NOT_REAP_CHILD),
+            CopyPasteWaylandChildSetup, NULL,
+            &pid, &stdinFd, NULL, NULL, &err)) {
+      g_warning("%s: failed to spawn wl-copy: %s\n", __FUNCTION__,
+                err != NULL ? err->message : "unknown error");
+      g_clear_error(&err);
+      return false;
+   }
+
+   bool success = true;
+   while (off < len) {
+      ssize_t written = write(stdinFd, data + off, len - off);
+      if (written < 0) {
+         if (errno == EINTR) {
+            continue;
+         }
+         g_warning("%s: write to wl-copy failed: %s\n", __FUNCTION__,
+                   g_strerror(errno));
+         success = false;
+         break;
+      }
+      off += (gsize) written;
+   }
+
+   /* Closing stdin is the EOF that lets wl-copy install the selection. */
+   close(stdinFd);
+
+   /* Wait for wl-copy to install the selection before it can be reread. */
+   gint status = 0;
+   pid_t waited;
+   for (;;) {
+      waited = waitpid(pid, &status, WNOHANG);
+      if (waited == pid) {
+         break;
+      }
+      if (waited < 0) {
+         if (errno == EINTR) {
+            continue;
+         }
+         g_warning("%s: wait for wl-copy failed: %s\n", __FUNCTION__,
+                   g_strerror(errno));
+         break;
+      }
+      if (CopyPasteWaylandRemainingMs(deadline) == 0) {
+         g_warning("%s: wl-copy did not install the selection in %d ms\n",
+                   __FUNCTION__, CP_WLCOPY_TIMEOUT_MS);
+         kill(-pid, SIGKILL);
+         kill(pid, SIGKILL);
+         do {
+            waited = waitpid(pid, &status, 0);
+         } while (waited < 0 && errno == EINTR);
+         success = false;
+         break;
+      }
+      g_usleep(1000);
+   }
+   g_spawn_close_pid(pid);
+
+   return success && waited == pid &&
+          WIFEXITED(status) && WEXITSTATUS(status) == 0;
+}
+
