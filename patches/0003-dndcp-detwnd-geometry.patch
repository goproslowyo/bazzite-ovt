From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GoProSlowYo <68455785+goproslowyo@users.noreply.github.com>
Date: Tue, 22 Sep 2026 21:29:21 -0700
Subject: [PATCH 3/6] dndcp: do not assume the compositor places the detection
 window as asked

The detection window is a small helper that a host to guest drag is started
from. Three things assumed the window ends up where and how it was asked to,
which holds on a stacking window manager and not otherwise.

It was mapped at the size of the monitor and resized to its real size
immediately afterwards. A compositor only has to honour the size a window is
mapped with, so one that ignores the later resize keeps a detection window
covering the whole output, above the drop target, taking the drop meant for
the window underneath. Map it at the size it is used at, and carry a size
request, which unlike a default size is applied on every map.

The press that starts the drag was aimed at the position the window was asked
to take. GTK starts a drag from a press and motion on the widget itself, so a
press that lands anywhere else starts nothing at all and no data is offered to
any target. Aim it at the position the window actually has.

Having moved the pointer there to press, put it back where the host has it
rather than waiting for the host's next motion: the target otherwise receives
XdndEnter after the button has already been released, and the drag ends in
XdndLeave instead of a drop.

A tiling compositor will still tile the window, and fixed size hints are the
ICCCM way to say that a window cannot usefully be resized. Sway honours them
by floating it. Where a compositor tiles it anyway, the window has to be
floated in that compositor's configuration.
---
 .../dndcp/dndGuestBase/dragDetWndX11GTK4.h    |  3 +-
 services/plugins/dndcp/dndUIX11GTK4.cpp       | 36 +++++++++++-
 services/plugins/dndcp/dragDetWndX11GTK4.cpp  | 56 +++++++++++++------
 3 files changed, 73 insertions(+), 22 deletions(-)

diff --git a/services/plugins/dndcp/dndGuestBase/dragDetWndX11GTK4.h b/services/plugins/dndcp/dndGuestBase/dragDetWndX11GTK4.h
index b55829e..e2372d9 100644
--- a/services/plugins/dndcp/dndGuestBase/dragDetWndX11GTK4.h
+++ b/services/plugins/dndcp/dndGuestBase/dragDetWndX11GTK4.h
@@ -75,6 +75,8 @@ public:
                         const bool buttonPress, const bool moveWindow,
                         const bool coordsProvided,
                         const int xCoord, const int yCoord);
+   /* Where the compositor actually put the window, not where we asked. */
+   void GetGeometry(int &x, int &y, int &width, int &height);
    void StartDrag(Glib::RefPtr<Gdk::ContentProvider> provider,
                   int mouseX,
                   int mouseY);
@@ -99,7 +101,6 @@ private:
    int GetScreenHeight();
    void SetGeometry(const int x, const int y,
                     const int width, const int height);
-   void GetGeometry(int &x, int &y, int &width, int &height);
    void SetIsVisible(const bool isVisible) {m_isVisible = isVisible;};
    bool GetIsVisible() {return m_isVisible;};
    bool SimulateMouseMove(const int x, const int y);
diff --git a/services/plugins/dndcp/dndUIX11GTK4.cpp b/services/plugins/dndcp/dndUIX11GTK4.cpp
index f677071..942f7b3 100644
--- a/services/plugins/dndcp/dndUIX11GTK4.cpp
+++ b/services/plugins/dndcp/dndUIX11GTK4.cpp
@@ -700,11 +700,41 @@ DnDUIX11::OnMoveMouse(int32 x,  // IN: Pointer x-coord
           * otherwise it may be another DnD, not ours. Send a release, then
           * a press here to cover this case.
           */
-         mDetWnd->SimulateXEvents(true, true, false, true, true, x, y);
+         int detX = 0, detY = 0, detW = 0, detH = 0;
+         int pressX = x, pressY = y;
+
+         /*
+          * GTK starts the drag from a press followed by motion on the
+          * detection window itself, so the press has to land on it. A
+          * compositor is free to put the window somewhere other than where
+          * it was asked to go, and a tiling one will, so press where the
+          * window actually is rather than where it was placed.
+          */
+         mDetWnd->GetGeometry(detX, detY, detW, detH);
+         if (detW > 0 && detH > 0) {
+            pressX = detX + detW / 2;
+            pressY = detY + detH / 2;
+            if (pressX != x || pressY != y) {
+               g_debug("%s: pressing on the detection window at (%d, %d), "
+                       "not the pointer at (%d, %d)\n", __FUNCTION__,
+                       pressX, pressY, x, y);
+            }
+         }
+         mDetWnd->SimulateXEvents(true, true, false, true, true, pressX, pressY);
          // simulate drag mouse press
-         mDetWnd->SimulateXEvents(false, true, true, false, true, x, y);
+         mDetWnd->SimulateXEvents(false, true, true, false, true, pressX, pressY);
          // Tell Gtk that a drag should be started from this widget.
-         mDetWnd->StartDrag(mProvider, x, y);
+         mDetWnd->StartDrag(mProvider, pressX, pressY);
+
+         /*
+          * Put the pointer back where the host has it. The press had to land
+          * on the detection window, but the drag tracks the pointer from
+          * here, and waiting for the next motion from the host costs the
+          * XDND handshake more time than the host leaves before it drops.
+          */
+         if (pressX != x || pressY != y) {
+            mDetWnd->SimulateXEvents(false, false, false, false, true, x, y);
+         }
          mHGDragStarted = true;
       }
       if (mEffect != DROP_MOVE) {
diff --git a/services/plugins/dndcp/dragDetWndX11GTK4.cpp b/services/plugins/dndcp/dragDetWndX11GTK4.cpp
index 5d84fa1..95f602b 100644
--- a/services/plugins/dndcp/dragDetWndX11GTK4.cpp
+++ b/services/plugins/dndcp/dragDetWndX11GTK4.cpp
@@ -476,27 +476,29 @@ void
 DragDetWnd::Show(void)
 {
    Glib::RefPtr<Gdk::Display> display = Gdk::Display::get_default();
-   int width = 0;
-   int height = 0;
    g_debug("%s: enter\n", __FUNCTION__);
-   if (display) {
-      Glib::RefPtr<Gio::ListModel> monitors = display->get_monitors();
-      if (!monitors || monitors->get_n_items() == 0)
-         return;
-
-      GListModel* c_model = monitors->gobj();
-      for (guint i = 0; i < monitors->get_n_items(); ++i) {
-         GObject* c_item = G_OBJECT(g_list_model_get_item(c_model, i));
-         Glib::RefPtr<Gdk::Monitor> monitor = Glib::wrap(GDK_MONITOR(c_item), true);
-         Gdk::Rectangle geometry = monitor->property_geometry();
-         mWnd->set_default_size(geometry.get_width(), geometry.get_height());
-         break;
-      }
-   } else {
-          g_error("%s: Cannot get default display \n", __FUNCTION__);
-          return;
+   if (!display) {
+      g_error("%s: Cannot get default display \n", __FUNCTION__);
+      return;
    }
 
+   /*
+    * Map at the size the window is actually used at. UpdateDetWnd() resizes
+    * it to this straight afterwards, but a compositor is only obliged to
+    * honour the size a window is mapped with: one that ignores the later
+    * resize is left with a detection window covering the whole output, on
+    * top of the drop target, where it takes the drop meant for the window
+    * underneath.
+    */
+   mWnd->set_default_size(DRAG_DET_WINDOW_WIDTH * 2, DRAG_DET_WINDOW_WIDTH * 2);
+   /*
+    * set_default_size() only applies the first time the window is mapped,
+    * and this one is mapped once and then hidden and shown for each drag.
+    * A size request is carried on every map, so a compositor that sizes the
+    * window itself is told the same thing each time.
+    */
+   mWnd->set_size_request(DRAG_DET_WINDOW_WIDTH * 2, DRAG_DET_WINDOW_WIDTH * 2);
+
    mWnd->set_sensitive(true);
    mWnd->set_visible(true);
 
@@ -893,6 +895,24 @@ DragDetWnd::ApplyDetWndMode(void)
    attrs.override_redirect = False;
    XChangeWindowAttributes(display, xwindow, CWOverrideRedirect, &attrs);
 
+   /*
+    * Fixed size hints, which is how ICCCM says a window cannot usefully be
+    * resized. A tiling compositor honours that by floating the window rather
+    * than fitting it into the layout: tiled, this 124x124 helper is stretched
+    * over the whole output, covers the drop target and swallows the drop.
+    */
+   {
+      XSizeHints *hints = XAllocSizeHints();
+
+      if (hints != NULL) {
+         hints->flags = PMinSize | PMaxSize;
+         hints->min_width = hints->max_width = DRAG_DET_WINDOW_WIDTH * 2;
+         hints->min_height = hints->max_height = DRAG_DET_WINDOW_WIDTH * 2;
+         XSetWMNormalHints(display, xwindow, hints);
+         XFree(hints);
+      }
+   }
+
    Atom wmType = XInternAtom(display, "_NET_WM_WINDOW_TYPE", False);
    Atom wmTypeDnd = XInternAtom(display, "_NET_WM_WINDOW_TYPE_DND", False);
    XChangeProperty(display, xwindow, wmType, XA_ATOM, 32, PropModeReplace,
