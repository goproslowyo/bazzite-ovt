From: GoProSlowYo <68455785+goproslowyo@users.noreply.github.com>
Date: Thu, 24 Sep 2026 21:25:09 -0700
Subject: [PATCH 02/22] dndcp: Offer file lists on desktops other than GNOME
 and KDE

LocalSetContentProvider() and the two uri-list builders in the GTK4 drag
and drop code matched XDG_CURRENT_DESKTOP against GNOME and KDE and
logged "Unsupported Desktop Manager" for anything else. A host to guest
file drop was then lost on sway, niri or any other desktop. The two
content provider branches built the same text/uri-list from the same
string, so merge them. The builders differ only in framing, and an
unrecognised desktop gets the form that text/uri-list specifies.

The GTK4 X11 copy and paste backend had the same checks where it
publishes a host file list, for a file paste and for file contents, and
gave up anywhere else, so a file paste was lost on Xfce. A desktop other
than GNOME or KDE, or none, now gets both the GNOME renderings and the
plain URI list, since its file manager may read either.

Tested by hand on Xfce 4.20 on Xorg with Thunar 4.20.9, pasting a file
copied in Windows Explorer.
---
 services/plugins/dndcp/copyPasteUIX11GTK4.cpp | 55 ++++++++++++++-----
 services/plugins/dndcp/dndUIX11GTK4.cpp       | 33 +++++------
 2 files changed, 57 insertions(+), 31 deletions(-)

diff --git a/services/plugins/dndcp/copyPasteUIX11GTK4.cpp b/services/plugins/dndcp/copyPasteUIX11GTK4.cpp
index 2571ebe..0467429 100644
--- a/services/plugins/dndcp/copyPasteUIX11GTK4.cpp
+++ b/services/plugins/dndcp/copyPasteUIX11GTK4.cpp
@@ -894,6 +894,35 @@ CopyPasteUIX11::CopyPasteSendFile(const Glib::RefPtr<Gio::AsyncResult>& result)
  }
 
 
+/*
+ *-----------------------------------------------------------------------------
+ *
+ * LocalOffersGnomeFileList --
+ * LocalOffersKdeFileList --
+ *
+ *      Which renderings of a host file list the clipboard offers under the
+ *      desktop XDG_CURRENT_DESKTOP names. GNOME gets the GNOME ones and KDE
+ *      the plain URI list. Any other desktop, or none, gets both, since its
+ *      file manager may read either.
+ *
+ *-----------------------------------------------------------------------------
+ */
+
+static bool
+LocalOffersGnomeFileList(const char *desktop)   // IN/OPT
+{
+   return desktop == NULL || strstr(desktop, "KDE") == NULL ||
+          strstr(desktop, "GNOME") != NULL;
+}
+
+
+static bool
+LocalOffersKdeFileList(const char *desktop)   // IN/OPT
+{
+   return desktop == NULL || strstr(desktop, "GNOME") == NULL;
+}
+
+
 /*
  *-----------------------------------------------------------------------------
  *
@@ -923,19 +952,17 @@ CopyPasteUIX11::LocalSetFileListToClipboard(const char* desktop)   // IN
    g_debug("%s: enter.\n", __FUNCTION__);
    g_debug("%s: Desktop = %s\n", __FUNCTION__, desktop);
 
-   if (desktop && strstr(desktop, "GNOME")) {
+   if (LocalOffersGnomeFileList(desktop)) {
       // Set the Gnome file list to GDKContentProvider
       fileListGnome = Glib::Bytes::create(mHGCopiedUriListGnome.c_str(), mHGCopiedUriListGnome.bytes());
       fileListNautilus = Glib::Bytes::create(mHGCopiedUriListNautilus.c_str(), mHGCopiedUriListNautilus.bytes());
       provider.push_back(Gdk::ContentProvider::create(FCP_TARGET_NAME_GNOME_COPIED_FILES, fileListGnome));
       provider.push_back(Gdk::ContentProvider::create(FCP_TARGET_NAME_NAUTILUS_GTK4_UTF8, fileListNautilus));
-   } else if (desktop && strstr(desktop, "KDE")) {
+   }
+   if (LocalOffersKdeFileList(desktop)) {
       // Set the Kde file list to GDKContentProvider
       fileListKde = Glib::Bytes::create(mHGCopiedUriListKde.c_str(), mHGCopiedUriListKde.bytes());
       provider.push_back(Gdk::ContentProvider::create(FCP_TARGET_NAME_URI_LIST, fileListKde));
-   } else {
-      g_warning("%s: Unsupported Desktop Manager %s. \n", __FUNCTION__, desktop);
-      return;
    }
 
    providerUnion = Gdk::ContentProvider::create(provider);
@@ -1097,7 +1124,7 @@ CopyPasteUIX11::LocalGetFileRequest()
          return;
       }
 
-      if (desktop && strstr(desktop, "GNOME")) {
+      if (LocalOffersGnomeFileList(desktop)) {
          /* Setting Gnome URIs for each path in the guest's file list. */
          mHGCopiedUriListGnome = "copy\n";
 	 BuildFileURIList(mHGCopiedUriListGnome, FCP_GNOME_LIST_PRE, FCP_GNOME_LIST_POST, stagingDirName);
@@ -1110,14 +1137,13 @@ CopyPasteUIX11::LocalGetFileRequest()
 	 /* Setting Nautilus URIs for each path in the guest's file list. */
          mHGCopiedUriListNautilus = utf::string(FCP_TARGET_MIME_NAUTILUS_FILES) + "\ncopy\n";
 	 BuildFileURIList(mHGCopiedUriListNautilus, FCP_GNOME_LIST_PRE, FCP_GNOME_LIST_POST, stagingDirName);
-      } else if (desktop && strstr(desktop, "KDE")) {
+      }
+      if (LocalOffersKdeFileList(desktop)) {
          /* Setting KDE URIs for each path in the guest's file list. */
+         mHGCopiedUriListKde = "";
 	 BuildFileURIList(mHGCopiedUriListKde, DND_URI_LIST_PRE_KDE, DND_URI_LIST_POST, stagingDirName);
 	 g_debug("%s: providing file list [%s]\n", __FUNCTION__,
                  mHGCopiedUriListKde.c_str());
-      } else {
-	 g_warning("%s: Unsupported Desktop Manager %s. \n", __FUNCTION__, desktop);
-         return;
       }
    }
 
@@ -1323,7 +1349,7 @@ CopyPasteUIX11::LocalGetFileContentsRequest()
 
    const char *desktop = getenv("XDG_CURRENT_DESKTOP");
 
-   if (desktop && strstr(desktop, "GNOME")) {
+   if (LocalOffersGnomeFileList(desktop)) {
       /* Setting Gnome URIs for each path in the guest's file list. */
       mHGCopiedUriListGnome = "copy\n";
       BuildFileContentURIList(mHGCopiedUriListGnome, FCP_GNOME_LIST_PRE, FCP_GNOME_LIST_POST);
@@ -1335,13 +1361,12 @@ CopyPasteUIX11::LocalGetFileContentsRequest()
       /* Setting Nautilus URIs for each path in the guest's file list. */
       mHGCopiedUriListNautilus = utf::string(FCP_TARGET_MIME_NAUTILUS_FILES) + "\ncopy\n";
       BuildFileContentURIList(mHGCopiedUriListNautilus, FCP_GNOME_LIST_PRE, FCP_GNOME_LIST_POST);
-   } else if (desktop && strstr(desktop, "KDE")) {
+   }
+   if (LocalOffersKdeFileList(desktop)) {
       /* Setting KDE URIs for each path in the guest's file list. */
+      mHGCopiedUriListKde = "";
       BuildFileContentURIList(mHGCopiedUriListKde, DND_URI_LIST_PRE_KDE, DND_URI_LIST_POST);
       g_debug("%s: providing file list [%s]\n", __FUNCTION__, mHGCopiedUriListKde.c_str());
-   } else {
-      g_warning("%s: Unsupported Desktop Manager %s. \n", __FUNCTION__, desktop);
-      return;
    }
 
    /* Set the content of clipboard with the File URI's. */
diff --git a/services/plugins/dndcp/dndUIX11GTK4.cpp b/services/plugins/dndcp/dndUIX11GTK4.cpp
index 247c7ed..3765e9a 100644
--- a/services/plugins/dndcp/dndUIX11GTK4.cpp
+++ b/services/plugins/dndcp/dndUIX11GTK4.cpp
@@ -357,8 +357,7 @@ void
 DnDUIX11::LocalSetContentProvider(const char* desktop)   // IN
 {
    std::vector<Glib::RefPtr<Gdk::ContentProvider>> providerVec;
-   Glib::RefPtr<Glib::Bytes> fileListGnome;
-   Glib::RefPtr<Glib::Bytes> fileListKde;
+   Glib::RefPtr<Glib::Bytes> fileList;
    void *buf;
    size_t sz;
 
@@ -366,18 +365,9 @@ DnDUIX11::LocalSetContentProvider(const char* desktop)   // IN
 
    if (CPClipboard_ItemExists(&mClipboard, CPFORMAT_FILELIST) ||
        CPClipboard_ItemExists(&mClipboard, CPFORMAT_FILECONTENTS)) {
-      if (desktop && strstr(desktop, "GNOME")) {
-         // Set the Gnome file list to GDKContentProvider
-         fileListGnome = Glib::Bytes::create(mHGDndUriList.c_str(), mHGDndUriList.bytes());
-         providerVec.push_back(Gdk::ContentProvider::create(DRAG_TARGET_NAME_URI_LIST, fileListGnome));
-      } else if (desktop && strstr(desktop, "KDE")) {
-         // Set the Kde file list to GDKContentProvider
-         fileListKde = Glib::Bytes::create(mHGDndUriList.c_str(), mHGDndUriList.bytes());
-         providerVec.push_back(Gdk::ContentProvider::create(DRAG_TARGET_NAME_URI_LIST, fileListKde));
-      } else {
-         g_warning("%s: Unsupported Desktop Manager %s. \n", __FUNCTION__, desktop);
-         return;
-      }
+      /* The caller has already framed the list for this desktop. */
+      fileList = Glib::Bytes::create(mHGDndUriList.c_str(), mHGDndUriList.bytes());
+      providerVec.push_back(Gdk::ContentProvider::create(DRAG_TARGET_NAME_URI_LIST, fileList));
    } else if (CPClipboard_ItemExists(&mClipboard, CPFORMAT_RTF)) {
       if (CPClipboard_GetItem(&mClipboard, CPFORMAT_RTF, &buf, &sz)) {
          g_debug("%s: RTF data, size %" FMTSZ "u.\n", __FUNCTION__, sz);
@@ -506,7 +496,15 @@ DnDUIX11::LocalGetFileRequest(utf::string stagingDirName,
       BuildFileURIList(mHGDndUriList, DND_URI_LIST_PRE_KDE, DND_URI_LIST_POST, stagingDirName);
       g_debug("%s: providing file list [%s]\n", __FUNCTION__, mHGDndUriList.c_str());
    } else {
-      g_warning("%s: Unsupported Desktop Manager %s. \n", __FUNCTION__, desktop);
+      /*
+       * Both cases above depart from text/uri-list. GNOME separates entries
+       * with a bare newline, and KDE drops the authority. Any other desktop
+       * gets the form the type specifies.
+       */
+      BuildFileURIList(mHGDndUriList, DND_URI_LIST_PRE, DND_URI_LIST_POST, stagingDirName);
+      g_debug("%s: %s, providing file list [%s]\n", __FUNCTION__,
+              desktop != NULL ? desktop : "no XDG_CURRENT_DESKTOP",
+              mHGDndUriList.c_str());
    }
 }
 
@@ -553,7 +551,10 @@ DnDUIX11::LocalGetFileContentsRequest(const char *desktop)
       BuildFileContentURIList(mHGDndUriList, DND_URI_LIST_PRE_KDE, DND_URI_LIST_POST);
       g_debug("%s: providing file list [%s]\n", __FUNCTION__, mHGDndUriList.c_str());
    } else {
-      g_warning("%s: Unsupported Desktop Manager %s. \n", __FUNCTION__, desktop);
+      BuildFileContentURIList(mHGDndUriList, DND_URI_LIST_PRE, DND_URI_LIST_POST);
+      g_debug("%s: %s, providing file list [%s]\n", __FUNCTION__,
+              desktop != NULL ? desktop : "no XDG_CURRENT_DESKTOP",
+              mHGDndUriList.c_str());
    }
 }
 
