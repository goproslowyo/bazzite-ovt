+/*
+ * waylandClipboard.h --
+ *
+ *    Own and read the Wayland selection directly, through
+ *    ext-data-control-v1.
+ *
+ *    The alternative is to shell out to wl-clipboard, which cannot express
+ *    what the host sends: wl-copy takes one --type and serves one payload,
+ *    so a rich text copy pasted into a plain text target yields the RTF
+ *    markup rather than a text rendering. A data control source can offer
+ *    several types and answer each request with the right bytes, which is
+ *    what the X11 backend does with multiple selection targets.
+ */
+
+#ifndef _WAYLAND_CLIPBOARD_H_
+#define _WAYLAND_CLIPBOARD_H_
+
+#include <glib.h>
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/*
+ * One format on offer. The data is copied when the offer is made, so the
+ * caller keeps ownership of its buffer.
+ */
+typedef struct {
+   const char *mimeType;
+   const void *data;
+   size_t size;
+} WaylandClipItem;
+
+/*
+ * Connect and bind ext-data-control-v1.
+ *
+ * Returns FALSE when the compositor does not implement the protocol, which
+ * is the caller's cue to fall back to wl-clipboard. GNOME is the notable
+ * case: it declines to implement data control protocols.
+ */
+gboolean WaylandClipboard_Init(void);
+void WaylandClipboard_Exit(void);
+gboolean WaylandClipboard_IsAvailable(void);
+
+/*
+ * Take the selection, offering every item. Items are served from memory for
+ * as long as the selection is held, so this returns immediately.
+ */
+gboolean WaylandClipboard_Offer(const WaylandClipItem *items, size_t nItems);
+
+/* Give up the selection. */
+void WaylandClipboard_Clear(void);
+
+/* Is mimeType among the types the current selection owner offers? */
+gboolean WaylandClipboard_HasType(const char *mimeType);
+
+/*
+ * Read the current selection as mimeType. Returns NULL when the type is not
+ * on offer or the owner does not answer within timeoutMs. Free with g_free().
+ */
+void *WaylandClipboard_Receive(const char *mimeType,
+                               size_t *size,
+                               unsigned int timeoutMs);
+
+/* TRUE while we are the selection owner, so our own offer is not re-read. */
+gboolean WaylandClipboard_IsOwner(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* _WAYLAND_CLIPBOARD_H_ */
