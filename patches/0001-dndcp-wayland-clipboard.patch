+/*
+ * waylandClipboard.c --
+ *
+ *    Own and read the Wayland selection through ext-data-control-v1.
+ *
+ *    This runs alongside GDK, which the plugin pins to its X11 backend for
+ *    the drag detection window, so it keeps its own connection to the
+ *    compositor and drives it from the GLib main loop.
+ */
+
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+
+#define G_LOG_DOMAIN "dndcp"
+
+#include "waylandClipboard.h"
+#include "ext-data-control-v1-client-protocol.h"
+
+#include <wayland-client.h>
+#include <glib-unix.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <sys/poll.h>
+#include <string.h>
+#include <unistd.h>
+
+/*
+ * The V3 argument ceiling is what the host will accept, so there is no point
+ * buffering a selection larger than that: the wl-clipboard fallback path in
+ * copyPasteUIWayland.cpp stops at the same limit. The standalone test harness
+ * builds this file without the dnd headers, hence the mirrored value.
+ */
+#if defined(__has_include)
+#  if __has_include("dndClipboard.h")
+#     include "dndClipboard.h"
+#  endif
+#endif
+#ifndef CPCLIPITEM_MAX_SIZE_V3
+#  define CPCLIPITEM_MAX_SIZE_V3 ((1 << 22) - 13 - 100)
+#endif
+
+/* A peer may advertise as many types as it likes; we keep a sane few. */
+#define WAYLAND_CLIP_MAX_TYPES 256
+#define WAYLAND_CLIP_MAX_MIME_LEN 256
+
+/* How long to keep draining a selection we have already decided to drop. */
+#define WAYLAND_CLIP_DRAIN_US (200 * 1000)
+
+
+typedef struct {
+   char *mimeType;
+   void *data;
+   size_t size;
+} ClipItem;
+
+static struct {
+   struct wl_display *display;
+   struct wl_registry *registry;
+   struct wl_seat *seat;
+   struct ext_data_control_manager_v1 *manager;
+   struct ext_data_control_device_v1 *device;
+
+   /* What we are offering, if we hold the selection. */
+   struct ext_data_control_source_v1 *source;
+   ClipItem *items;
+   size_t nItems;
+
+   /* What somebody else is offering. */
+   struct ext_data_control_offer_v1 *offer;
+   GPtrArray *offerTypes;          /* char *, owned by gClip.offer, not by us */
+
+   guint watch;
+   gboolean inited;
+} gClip;
+
+
+/*
+ *-----------------------------------------------------------------------------
+ *
+ * FreeItems --
+ *
+ *    Release the copy of whatever we were offering.
+ *
+ *-----------------------------------------------------------------------------
+ */
+
+static void
+FreeItems(void)
+{
+   size_t i;
+
+   for (i = 0; i < gClip.nItems; i++) {
+      g_free(gClip.items[i].mimeType);
+      g_free(gClip.items[i].data);
+   }
+   g_free(gClip.items);
+   gClip.items = NULL;
+   gClip.nItems = 0;
+}
+
+
+/*
+ *-----------------------------------------------------------------------------
+ *
+ * SourceSend --
+ *
+ *    A paste happened: write the bytes for the requested type.
+ *
+ *    Writing can block if the reader is slow or goes away, so the pipe is put
+ *    into non-blocking mode and given a bounded number of attempts. A stuck
+ *    reader must not wedge the main loop, which also carries the RPC channel.
+ *
+ *-----------------------------------------------------------------------------
+ */
+
+static void
+SourceSend(void *data,                                 // IN: unused
+           struct ext_data_control_source_v1 *source,  // IN
+           const char *mimeType,                       // IN
+           int32_t fd)                                 // IN
+{
+   size_t i;
+
+   for (i = 0; i < gClip.nItems; i++) {
+      if (strcmp(gClip.items[i].mimeType, mimeType) == 0) {
+         const char *p = gClip.items[i].data;
+         size_t left = gClip.items[i].size;
+         gint64 deadline = g_get_monotonic_time() + 2 * G_USEC_PER_SEC;
+         int lastErrno = 0;
+
+         if (!g_unix_set_fd_nonblocking(fd, TRUE, NULL)) {
+            g_debug("%s: could not make the pipe non-blocking\n", __FUNCTION__);
+         }
+         while (left > 0 && g_get_monotonic_time() < deadline) {
+            ssize_t n = write(fd, p, left);
+
+            if (n > 0) {
+               p += n;
+               left -= (size_t) n;
+               continue;
+            }
+            lastErrno = errno;
+            if (n < 0 && (lastErrno == EAGAIN || lastErrno == EINTR)) {
+               struct pollfd pfd;
+
+               pfd.fd = fd;
+               pfd.events = POLLOUT;
+               pfd.revents = 0;
+               if (poll(&pfd, 1, 20) > 0 && (pfd.revents & (POLLERR | POLLHUP))) {
+                  break;
+               }
+               continue;
+            }
+            break;
+         }
+         if (left > 0) {
+            /*
+             * EPIPE here is routine rather than a failure: a clipboard
+             * manager may ask for a type, decide it does not want it and
+             * close the pipe. Anything else is worth seeing.
+             */
+            if (lastErrno == EPIPE) {
+               g_debug("%s: reader closed %s early, %" G_GSIZE_FORMAT
+                       " bytes unsent\n", __FUNCTION__, mimeType, (gsize) left);
+            } else {
+               g_warning("%s: %" G_GSIZE_FORMAT " of %" G_GSIZE_FORMAT
+                         " bytes of %s unsent: %s\n", __FUNCTION__,
+                         (gsize) left, (gsize) gClip.items[i].size, mimeType,
+                         lastErrno != 0 ? g_strerror(lastErrno) : "deadline");
+            }
+         }
+         close(fd);
+         return;
+      }
+   }
+
+   g_debug("%s: nothing on offer for %s\n", __FUNCTION__, mimeType);
+   close(fd);
+}
+
+
+static void
+SourceCancelled(void *data,                                // IN: unused
+                struct ext_data_control_source_v1 *source) // IN
+{
+   /* Another client took the selection. */
+   if (gClip.source == source) {
+      gClip.source = NULL;
+      FreeItems();
+   }
+   ext_data_control_source_v1_destroy(source);
+}
+
+
+static const struct ext_data_control_source_v1_listener gSourceListener = {
+   .send = SourceSend,
+   .cancelled = SourceCancelled,
+};
+
+
+/*
+ *-----------------------------------------------------------------------------
+ *
+ * Offer listener: collect the types the current owner advertises.
+ *
+ *    The type list hangs off the offer object rather than off gClip, because
+ *    the compositor describes an offer for the primary selection the same way
+ *    it describes one for the regular selection: a single global list would
+ *    end up describing whichever offer arrived last.
+ *
+ *-----------------------------------------------------------------------------
+ */
+
+static void
+OfferType(void *data,                               // IN: unused
+          struct ext_data_control_offer_v1 *offer,  // IN
+          const char *mimeType)                     // IN
+{
+   GPtrArray *types;
+
+   if (offer == NULL || mimeType == NULL) {
+      return;
+   }
+   types = ext_data_control_offer_v1_get_user_data(offer);
+   if (types == NULL) {
+      return;
+   }
+   if (types->len >= WAYLAND_CLIP_MAX_TYPES) {
+      g_debug("%s: more than %d types offered, ignoring %s\n", __FUNCTION__,
+              WAYLAND_CLIP_MAX_TYPES, mimeType);
+      return;
+   }
+   if (strlen(mimeType) > WAYLAND_CLIP_MAX_MIME_LEN) {
+      g_debug("%s: over-long MIME type ignored\n", __FUNCTION__);
+      return;
+   }
+   g_ptr_array_add(types, g_strdup(mimeType));
+}
+
+
+static const struct ext_data_control_offer_v1_listener gOfferListener = {
+   .offer = OfferType,
+};
+
+
+/*
+ *-----------------------------------------------------------------------------
+ *
+ * OfferDestroy --
+ *
+ *    Drop an offer along with the type list it owns.
+ *
+ * Side effects:
+ *    The list is freed here and nowhere else, so callers must forget any
+ *    borrowed pointer to it first.
+ *
+ *-----------------------------------------------------------------------------
+ */
+
+static void
+OfferDestroy(struct ext_data_control_offer_v1 *offer)  // IN
+{
+   GPtrArray *types;
+
+   if (offer == NULL) {
+      return;
+   }
+   types = ext_data_control_offer_v1_get_user_data(offer);
+   if (types != NULL) {
+      ext_data_control_offer_v1_set_user_data(offer, NULL);
+      g_ptr_array_free(types, TRUE);
+   }
+   ext_data_control_offer_v1_destroy(offer);
+}
+
+
+static void
+DeviceDataOffer(void *data,                               // IN: unused
+                struct ext_data_control_device_v1 *device,// IN
+                struct ext_data_control_offer_v1 *offer)  // IN
+{
+   /*
+    * A new offer is being described; its types arrive next. The listener has
+    * to go on first, because adding one sets the proxy user data.
+    */
+   ext_data_control_offer_v1_add_listener(offer, &gOfferListener, NULL);
+   ext_data_control_offer_v1_set_user_data(offer,
+                                           g_ptr_array_new_with_free_func(g_free));
+}
+
+
+static void
+DeviceSelection(void *data,                                // IN: unused
+                struct ext_data_control_device_v1 *device, // IN
+                struct ext_data_control_offer_v1 *offer)   // IN
+{
+   if (gClip.offer != NULL && gClip.offer != offer) {
+      gClip.offerTypes = NULL;
+      OfferDestroy(gClip.offer);
+   }
+   gClip.offer = offer;
+   gClip.offerTypes = offer != NULL ?
+      ext_data_control_offer_v1_get_user_data(offer) : NULL;
+}
+
+
+static void
+DevicePrimarySelection(void *data,
+                       struct ext_data_control_device_v1 *device,
+                       struct ext_data_control_offer_v1 *offer)
+{
+   /* The primary selection is not mirrored to the host. */
+   if (offer != NULL && offer != gClip.offer) {
+      OfferDestroy(offer);
+   }
+}
+
+
+/*
+ *-----------------------------------------------------------------------------
+ *
+ * DeviceFinished --
+ *
+ *    The compositor has taken the device away: every request on it from now
+ *    on is a protocol error, so shut the module down and let the callers fall
+ *    back to wl-clipboard.
+ *
+ *-----------------------------------------------------------------------------
+ */
+
+static void
+DeviceFinished(void *data, struct ext_data_control_device_v1 *device)
+{
+   g_debug("%s: the compositor finished the data device\n", __FUNCTION__);
+   if (gClip.device != NULL) {
+      ext_data_control_device_v1_destroy(gClip.device);
+      gClip.device = NULL;
+   }
+   gClip.inited = FALSE;
+}
+
+
+static const struct ext_data_control_device_v1_listener gDeviceListener = {
+   .data_offer = DeviceDataOffer,
+   .selection = DeviceSelection,
+   .finished = DeviceFinished,
+   .primary_selection = DevicePrimarySelection,
+};
+
+
+static void
+RegistryGlobal(void *data,                  // IN: unused
+               struct wl_registry *registry,// IN
+               uint32_t name,               // IN
+               const char *iface,           // IN
+               uint32_t version)            // IN
+{
+   if (strcmp(iface, ext_data_control_manager_v1_interface.name) == 0) {
+      gClip.manager = wl_registry_bind(registry, name,
+                                       &ext_data_control_manager_v1_interface,
+                                       1);
+   } else if (strcmp(iface, wl_seat_interface.name) == 0 &&
+              gClip.seat == NULL) {
+      gClip.seat = wl_registry_bind(registry, name, &wl_seat_interface, 1);
+   }
+}
+
+
+static void
+RegistryGlobalRemove(void *data, struct wl_registry *registry, uint32_t name)
+{
+}
+
+
+static const struct wl_registry_listener gRegistryListener = {
+   .global = RegistryGlobal,
+   .global_remove = RegistryGlobalRemove,
+};
+
+
+/*
+ *-----------------------------------------------------------------------------
+ *
+ * DisplayReadable --
+ *
+ *    Main loop callback: the compositor has something for us. This is how a
+ *    paste request reaches SourceSend() while the plugin goes about its
+ *    business.
+ *
+ * Side effects:
+ *    A dead display tears the module down, so that IsAvailable() turns FALSE
+ *    and the callers go back to wl-clipboard instead of talking to a
+ *    connection that will never answer.
+ *
+ *-----------------------------------------------------------------------------
+ */
+
+static gboolean
+DisplayReadable(gint fd,             // IN: unused
+                GIOCondition cond,   // IN
+                gpointer data)       // IN: unused
+{
+   if ((cond & (G_IO_HUP | G_IO_ERR)) != 0) {
+      g_warning("%s: lost the compositor connection\n", __FUNCTION__);
+      /* Returning G_SOURCE_REMOVE drops the watch; do not remove it twice. */
+      gClip.watch = 0;
+      WaylandClipboard_Exit();
+      return G_SOURCE_REMOVE;
+   }
+   if (wl_display_dispatch(gClip.display) < 0) {
+      g_warning("%s: dispatch failed: %s\n", __FUNCTION__, g_strerror(errno));
+      gClip.watch = 0;
+      WaylandClipboard_Exit();
+      return G_SOURCE_REMOVE;
+   }
+   wl_display_flush(gClip.display);
+
+   return G_SOURCE_CONTINUE;
+}
+
+
+/*
+ *-----------------------------------------------------------------------------
+ *
+ * WaylandClipboard_Init --
+ *
+ *-----------------------------------------------------------------------------
+ */
+
+gboolean
+WaylandClipboard_Init(void)
+{
+   if (gClip.inited) {
+      return TRUE;
+   }
+   memset(&gClip, 0, sizeof gClip);
+
+   gClip.display = wl_display_connect(NULL);
+   if (gClip.display == NULL) {
+      g_debug("%s: no Wayland display\n", __FUNCTION__);
+      return FALSE;
+   }
+
+   gClip.registry = wl_display_get_registry(gClip.display);
+   wl_registry_add_listener(gClip.registry, &gRegistryListener, NULL);
+   wl_display_roundtrip(gClip.display);
+
+   if (gClip.manager == NULL || gClip.seat == NULL) {
+      g_debug("%s: ext-data-control-v1 is not available\n", __FUNCTION__);
+      wl_display_disconnect(gClip.display);
+      memset(&gClip, 0, sizeof gClip);
+      return FALSE;
+   }
+
+   gClip.device =
+      ext_data_control_manager_v1_get_data_device(gClip.manager, gClip.seat);
+   ext_data_control_device_v1_add_listener(gClip.device, &gDeviceListener,
+                                           NULL);
+   wl_display_roundtrip(gClip.display);
+
+   gClip.watch = g_unix_fd_add(wl_display_get_fd(gClip.display),
+                               G_IO_IN | G_IO_HUP | G_IO_ERR,
+                               DisplayReadable, NULL);
+   gClip.inited = TRUE;
+   g_debug("%s: using ext-data-control-v1\n", __FUNCTION__);
+
+   return TRUE;
+}
+
+
+/*
+ *-----------------------------------------------------------------------------
+ *
+ * WaylandClipboard_Exit --
+ *
+ *    Give everything back. Safe to call on a half torn down module, which is
+ *    what DeviceFinished() and a failed dispatch leave behind, so the display
+ *    rather than the inited flag decides whether there is work to do.
+ *
+ *-----------------------------------------------------------------------------
+ */
+
+void
+WaylandClipboard_Exit(void)
+{
+   if (gClip.display == NULL) {
+      return;
+   }
+   if (gClip.watch != 0) {
+      g_source_remove(gClip.watch);
+   }
+   if (gClip.source != NULL) {
+      ext_data_control_source_v1_destroy(gClip.source);
+   }
+   FreeItems();
+   gClip.offerTypes = NULL;
+   OfferDestroy(gClip.offer);
+   if (gClip.device != NULL) {
+      ext_data_control_device_v1_destroy(gClip.device);
+   }
+   if (gClip.display != NULL) {
+      wl_display_disconnect(gClip.display);
+   }
+   memset(&gClip, 0, sizeof gClip);
+}
+
+
+gboolean
+WaylandClipboard_IsAvailable(void)
+{
+   return gClip.inited;
+}
+
+
+gboolean
+WaylandClipboard_IsOwner(void)
+{
+   return gClip.inited && gClip.source != NULL;
+}
+
+
+/*
+ *-----------------------------------------------------------------------------
+ *
+ * WaylandClipboard_Offer --
+ *
+ *    Take the selection, offering every item. The data is copied, so the
+ *    caller may free its buffers on return.
+ *
+ *-----------------------------------------------------------------------------
+ */
+
+gboolean
+WaylandClipboard_Offer(const WaylandClipItem *items,  // IN
+                       size_t nItems)                 // IN
+{
+   size_t i;
+
+   if (!gClip.inited || gClip.device == NULL || items == NULL || nItems == 0) {
+      return FALSE;
+   }
+
+   if (gClip.source != NULL) {
+      ext_data_control_source_v1_destroy(gClip.source);
+      gClip.source = NULL;
+   }
+   FreeItems();
+
+   gClip.items = g_new0(ClipItem, nItems);
+   for (i = 0; i < nItems; i++) {
+      gClip.items[i].mimeType = g_strdup(items[i].mimeType);
+      if (items[i].data != NULL && items[i].size > 0) {
+         gClip.items[i].data = g_malloc(items[i].size);
+         memcpy(gClip.items[i].data, items[i].data, items[i].size);
+         gClip.items[i].size = items[i].size;
+      }
+   }
+   gClip.nItems = nItems;
+
+   gClip.source =
+      ext_data_control_manager_v1_create_data_source(gClip.manager);
+   ext_data_control_source_v1_add_listener(gClip.source, &gSourceListener,
+                                           NULL);
+   for (i = 0; i < nItems; i++) {
+      ext_data_control_source_v1_offer(gClip.source, items[i].mimeType);
+   }
+   ext_data_control_device_v1_set_selection(gClip.device, gClip.source);
+   wl_display_flush(gClip.display);
+
+   return TRUE;
+}
+
+
+void
+WaylandClipboard_Clear(void)
+{
+   if (!gClip.inited) {
+      return;
+   }
+   if (gClip.device != NULL) {
+      ext_data_control_device_v1_set_selection(gClip.device, NULL);
+   }
+   if (gClip.source != NULL) {
+      ext_data_control_source_v1_destroy(gClip.source);
+      gClip.source = NULL;
+   }
+   FreeItems();
+   wl_display_flush(gClip.display);
+}
+
+
+gboolean
+WaylandClipboard_HasType(const char *mimeType)  // IN
+{
+   guint i;
+
+   if (!gClip.inited || gClip.offerTypes == NULL || mimeType == NULL) {
+      return FALSE;
+   }
+   for (i = 0; i < gClip.offerTypes->len; i++) {
+      if (strcmp((const char *) g_ptr_array_index(gClip.offerTypes, i),
+                 mimeType) == 0) {
+         return TRUE;
+      }
+   }
+
+   return FALSE;
+}
+
+
+/*
+ *-----------------------------------------------------------------------------
+ *
+ * WaylandClipboard_Receive --
+ *
+ *    Read the current selection as mimeType.
+ *
+ *    The owner writes at its own pace, so the read is polled with a deadline
+ *    rather than left to block: this runs on the main loop that also carries
+ *    the RPC channel, and a peer that stops writing must not wedge it.
+ *
+ *-----------------------------------------------------------------------------
+ */
+
+void *
+WaylandClipboard_Receive(const char *mimeType,    // IN
+                         size_t *size,            // OUT
+                         unsigned int timeoutMs)  // IN
+{
+   int fds[2];
+   GByteArray *acc;
+   gint64 deadline;
+   gboolean dropped = FALSE;
+
+   if (size != NULL) {
+      *size = 0;
+   }
+   if (!gClip.inited || gClip.offer == NULL || mimeType == NULL) {
+      return NULL;
+   }
+   if (!WaylandClipboard_HasType(mimeType)) {
+      return NULL;
+   }
+   /*
+    * pipe2() rather than g_unix_open_pipe(), whose FD_CLOEXEC argument only
+    * means what it says from GLib 2.78 on.
+    */
+   if (pipe2(fds, O_CLOEXEC) != 0) {
+      g_debug("%s: pipe2 failed: %s\n", __FUNCTION__, g_strerror(errno));
+      return NULL;
+   }
+
+   ext_data_control_offer_v1_receive(gClip.offer, mimeType, fds[1]);
+   wl_display_flush(gClip.display);
+   close(fds[1]);
+
+   if (!g_unix_set_fd_nonblocking(fds[0], TRUE, NULL)) {
+      g_debug("%s: could not make the pipe non-blocking\n", __FUNCTION__);
+   }
+
+   acc = g_byte_array_new();
+   deadline = g_get_monotonic_time() + (gint64) timeoutMs * 1000;
+
+   for (;;) {
+      char buf[16 * 1024];
+      ssize_t n;
+
+      /*
+       * The deadline belongs at the top: a peer that keeps the pipe full
+       * never yields EAGAIN, and this loop holds the main loop that also
+       * carries the RPC channel.
+       */
+      if (g_get_monotonic_time() >= deadline) {
+         g_debug("%s: %s timed out after %ums\n", __FUNCTION__, mimeType,
+                 timeoutMs);
+         break;
+      }
+
+      n = read(fds[0], buf, sizeof buf);
+
+      if (n > 0) {
+         if (!dropped &&
+             (gsize) acc->len + (gsize) n > (gsize) CPCLIPITEM_MAX_SIZE_V3) {
+            /*
+             * Past the ceiling the host would refuse it anyway. Keep reading
+             * for a moment so the owner's write does not block on a full
+             * pipe, but throw the bytes away.
+             */
+            g_debug("%s: %s selection exceeds the V3 limit, dropping\n",
+                    __FUNCTION__, mimeType);
+            dropped = TRUE;
+            deadline = MIN(deadline,
+                           g_get_monotonic_time() + WAYLAND_CLIP_DRAIN_US);
+         }
+         if (!dropped) {
+            g_byte_array_append(acc, (const guint8 *) buf, (guint) n);
+         }
+         continue;
+      }
+      if (n == 0) {
+         break;                        /* the owner finished */
+      }
+      if (errno == EAGAIN || errno == EINTR) {
+         struct pollfd pfd = { .fd = fds[0], .events = POLLIN };
+         gint64 left = (deadline - g_get_monotonic_time()) / 1000;
+
+         if (left > 0) {
+            poll(&pfd, 1, (int) left);
+         }
+         continue;
+      }
+      break;
+   }
+   close(fds[0]);
+
+   if (dropped) {
+      g_byte_array_free(acc, TRUE);
+      return NULL;
+   }
+   if (acc->len == 0) {
+      g_byte_array_free(acc, TRUE);
+      return NULL;
+   }
+   if (size != NULL) {
+      *size = acc->len;
+   }
+
+   return g_byte_array_free(acc, FALSE);
+}
