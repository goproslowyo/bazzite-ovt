+#include "copyPasteDnDWayland.h"
 #endif
 
 #if defined(WIN32)
@@ -149,7 +150,24 @@ CopyPasteDnDWrapper::Init(ToolsAppCtx *ctx)
 
    if (!m_pimpl) {
 #if defined(HAVE_GTKMM)
-      m_pimpl = new CopyPasteDnDX11();
+      /*
+       * Prefer the Wayland clipboard backend when running under a Wayland
+       * session. The X11 backend relies on GtkClipboard / X selections and
+       * Xwayland, which do not work for this windowless daemon on wlroots
+       * compositors (Sway, Hyprland, river, ...). Selection is by environment
+       * so a single build serves both X11 and Wayland sessions: pick Wayland
+       * when WAYLAND_DISPLAY is set and we are either in a Wayland session or
+       * have no X display at all.
+       */
+      if (g_getenv("WAYLAND_DISPLAY") != NULL &&
+          (g_getenv("DISPLAY") == NULL ||
+           g_strcmp0(g_getenv("XDG_SESSION_TYPE"), "wayland") == 0)) {
+         g_debug("%s: Wayland session detected, using Wayland CP backend.\n",
+                 __FUNCTION__);
+         m_pimpl = new CopyPasteDnDWayland();
+      } else {
+         m_pimpl = new CopyPasteDnDX11();
+      }
 #endif
 #if defined(WIN32)
