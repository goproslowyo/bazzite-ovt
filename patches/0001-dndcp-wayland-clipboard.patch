+/**
+ * @file copyPasteUIWayland.h
+ *
+ * This class implements host<->guest copy/paste (version 3+ of the protocol)
+ * for Wayland sessions, without any X11/GTK dependency. The local clipboard is
+ * driven through the wl-clipboard utilities (wl-copy / wl-paste), which speak
+ * the wlr-data-control protocol and therefore work for this windowless daemon
+ * on wlroots-based compositors (Sway, Hyprland, river, ...). This is the
+ * counterpart of copyPasteUIX11.h for the Wayland platform.
+ *
+ * Text only: no image, RTF, file list or file contents support (those remain
+ * X11-only for now).
+ */
+
+#ifndef __COPYPASTE_UI_WAYLAND_H__
+#define __COPYPASTE_UI_WAYLAND_H__
+
+#include <string>
+#include <pthread.h>
+#include <sigc++/trackable.h>
+
+#include "vm_basic_types.h"
+#include "dnd.h"
+
+extern "C" {
+#include "dndClipboard.h"
+#include "vmware/tools/guestrpc.h"
+}
+
+#include "guestCopyPaste.hh"
+
+class CopyPasteUIWayland;
+
+/*
+ * Parameters for the vmblock notify monitor thread. The thread blocks in
+ * read(2) on a path under VMBLOCK_FUSE_NOTIFY_ROOT; the read returns as soon
+ * as another process touches the corresponding blocked path, which is our cue
+ * that the user actually pasted and the transfer should start.
+ */
+struct WaylandThreadParams
+{
+   pthread_mutex_t fileBlockMutex;
+   pthread_cond_t fileBlockCond;
+   bool fileBlockCondExit;
+   CopyPasteUIWayland *cp;
+   std::string fileBlockName;
+};
+
+class CopyPasteUIWayland
+   : public sigc::trackable
+{
+public:
+   CopyPasteUIWayland();
+   virtual ~CopyPasteUIWayland();
+   bool Init();
+   void VmxCopyPasteVersionChanged(RpcChannel *chan, uint32 version);
+   void SetCopyPasteAllowed(bool isCopyPasteAllowed)
+   { mCP->SetCopyPasteAllowed(isCopyPasteAllowed); }
+
+   void SetBlockControl(DnDBlockControl *blockCtrl)
+   { mBlockCtrl = blockCtrl; }
+
+   bool IsBlockAdded() const { return mBlockAdded; }
+
+   /*
+    * Ask the host to transfer the files into the staging directory we already
+    * published URIs for. Passing the directory explicitly matters: with an
+    * empty argument SetupDestDir() calls DnD_CreateStagingDirectory() and
+    * happens to reuse our still-empty directory, which the X11 backend relies
+    * on implicitly. Being explicit removes that coupling.
