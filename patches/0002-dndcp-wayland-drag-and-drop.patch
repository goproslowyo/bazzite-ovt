+
+/*
+ *-----------------------------------------------------------------------------
+ *
+ * DragDetWnd::ApplyDetWndMode --
+ *
+ *    Keep the detection window unactivatable without hiding it from the
+ *    compositor.
+ *
+ *    Under Wayland the window has to stay managed. A compositor bridging a
+ *    native Wayland drag to an Xwayland window looks the target up among its
+ *    managed clients only, so an override-redirect detection window never
+ *    receives XdndEnter. On KWin that is Workspace::findClient() by way of
+ *    XwlDropHandler::updateDragTarget(), with pickDragTarget() skipping
+ *    anything that is not a client.
+ *
+ *    Focus is suppressed with hints instead: _NET_WM_WINDOW_TYPE_DND,
+ *    _NET_WM_USER_TIME 0, skip taskbar, skip pager, and WM_HINTS input False.
+ *
+ *    X latches override-redirect at map time, so this has to run while the
+ *    window is mapped for the next map to see it. It is idempotent and is
+ *    called from both the constructor and Show().
+ *
+ * Results:
+ *    None.
+ *
+ * Side effects:
+ *    Changes window attributes and properties on the X server.
+ *
+ *-----------------------------------------------------------------------------
+ */
+
+void
+DragDetWnd::ApplyDetWndMode(void)
+{
+   GtkWidget *widget = GetWnd()->gobj();
+   GtkNative *native = gtk_widget_get_native(widget);
+   GdkSurface *surface = native ? gtk_native_get_surface(native) : NULL;
+
+   if (surface == NULL || !GDK_IS_X11_SURFACE(surface)) {
+      g_debug("%s: no X11 surface; detection window may steal focus\n",
+              __FUNCTION__);
+      return;
+   }
+
+   Display *display =
+      gdk_x11_display_get_xdisplay(gdk_surface_get_display(surface));
+   Window xwindow = gdk_x11_surface_get_xid(surface);
+
+   XSetWindowAttributes attrs;
+
+   gdk_x11_display_error_trap_push(gdk_surface_get_display(surface));
+
+   attrs.override_redirect = False;
+   XChangeWindowAttributes(display, xwindow, CWOverrideRedirect, &attrs);
+
+   Atom wmType = XInternAtom(display, "_NET_WM_WINDOW_TYPE", False);
+   Atom wmTypeDnd = XInternAtom(display, "_NET_WM_WINDOW_TYPE_DND", False);
+   XChangeProperty(display, xwindow, wmType, XA_ATOM, 32, PropModeReplace,
+                   (unsigned char *) &wmTypeDnd, 1);
+
+   Atom userTime = XInternAtom(display, "_NET_WM_USER_TIME", False);
+   unsigned long zero = 0;
+   XChangeProperty(display, xwindow, userTime, XA_CARDINAL, 32,
+                   PropModeReplace, (unsigned char *) &zero, 1);
+
+   {
+      Atom skipTaskbar =
+         XInternAtom(display, "_NET_WM_STATE_SKIP_TASKBAR", False);
+      Atom skipPager = XInternAtom(display, "_NET_WM_STATE_SKIP_PAGER", False);
+      Atom wmState = XInternAtom(display, "_NET_WM_STATE", False);
+      Atom states[2];
+
+      states[0] = skipTaskbar;
+      states[1] = skipPager;
+      XChangeProperty(display, xwindow, wmState, XA_ATOM, 32, PropModeReplace,
+                      (unsigned char *) states, 2);
+
+      /*
+       * This only counts while the window is unmapped; GTK rewrites the
+       * property when it maps the window. RequestSkipTaskbar() re-asserts it
+       * with a client message once the window manager has the window.
+       */
+
+      /*
+       * input False tells the window manager not to give this window the
+       * keyboard focus (ICCCM 4.1.7, "globally active" input model). With
+       * no WM_TAKE_FOCUS protocol this makes KWin's wantsInput() false, so
+       * the requestFocus() that its drag filter issues for the window under
+       * the cursor cannot activate it.
+       */
+      XWMHints *hints = XGetWMHints(display, xwindow);
+      XWMHints fresh;
+
+      if (hints == NULL) {
+         memset(&fresh, 0, sizeof fresh);
+         hints = &fresh;
+      }
+      hints->flags |= InputHint;
+      hints->input = False;
+      XSetWMHints(display, xwindow, hints);
+      if (hints != &fresh) {
+         XFree(hints);
+      }
+   }
+
+   XFlush(display);
+
+   /*
+    * Read back what the server holds, so the log shows what the window
+    * manager will see at the next map rather than what we asked for.
+    */
+   {
+      XWindowAttributes actual;
+
+      memset(&actual, 0, sizeof actual);
+      if (XGetWindowAttributes(display, xwindow, &actual) != 0) {
+         g_debug("%s: detwnd 0x%lx override_redirect=%d mapped=%d\n",
+                 __FUNCTION__, (unsigned long) xwindow,
+                 actual.override_redirect,
+                 actual.map_state == IsViewable);
+      }
+   }
+
+   gdk_x11_display_error_trap_pop_ignored(gdk_surface_get_display(surface));
+}
