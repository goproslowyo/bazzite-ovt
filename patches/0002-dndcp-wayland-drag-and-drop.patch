+
 /*
  *-----------------------------------------------------------------------------
  *
@@ -1046,6 +1103,297 @@ DnDUIX11::OnGtkSrcDragCancel(const Glib::RefPtr< Gdk::Drag > &drag,
  */
 
 
+/*
+ *-----------------------------------------------------------------------------
+ *
+ * Reading the dragged file list without the document portal.
+ *
+ *    KDE offers application/vnd.portal.filetransfer next to text/uri-list and
+ *    GDK prefers it. gdk_drop_read_value_async(GDK_TYPE_FILE_LIST) picks the
+ *    portal type, fetches its token over XdndSelection, then fails to redeem
+ *    the token with "Unable to open /proc/<pid>/root".
+ *
+ *    The document portal authenticates a caller by opening /proc/<pid>/root,
+ *    which cannot work here. vmusr is exec'd by a setuid wrapper, and that
+ *    clears the kernel's dumpable flag, leaving /proc/<pid> owned by root even
+ *    after the process drops back to the user.
+ *
+ *    Read text/uri-list instead. It is on offer, it needs no portal, and it
+ *    travels over the same XdndSelection transfer.
+ *
+ *    The stream has to be drained asynchronously. gdk_drop_read_finish() warns
+ *    against blocking reads on the returned stream in the GTK thread, and a
+ *    synchronous drain here deadlocks the main loop.
+ *
+ *-----------------------------------------------------------------------------
+ */
+
+#define DND_URI_LIST_CHUNK   (16 * 1024)
+#define DND_URI_LIST_MAX     (1 << 20)
+
+/*
+ * ui is cleared by DnDUIX11::CancelGHRead() when the drag ends or the object
+ * goes away, so a callback that is already queued finds NULL rather than a
+ * destroyed object. The cancellable is referenced here rather than read back
+ * from the UI, so that re-arming the read cannot pick up a different one.
+ */
+typedef struct {
+   DnDUIX11 *ui;
+   GCancellable *cancel;
+   GInputStream *stream;
+   GString *acc;
+} DnDUriListRead;
+
+
+static void
+DnDUriListReadFree(DnDUriListRead *rd)  // IN
+{
+   if (rd == NULL) {
+      return;
+   }
+   if (rd->ui != NULL) {
+      rd->ui->ForgetGHRead(rd);
+      rd->ui = NULL;
+   }
+   if (rd->stream != NULL) {
+      /*
+       * Closing can round trip to the drag source, and this stream must not
+       * see a blocking call on the GTK thread. Dropping the reference is
+       * enough; GIO closes it.
+       */
+      g_object_unref(rd->stream);
+   }
+   if (rd->cancel != NULL) {
+      g_object_unref(rd->cancel);
+   }
+   if (rd->acc != NULL) {
+      g_string_free(rd->acc, TRUE);
+   }
+   g_free(rd);
+}
+
+
+static void DnDUriListReadChunk(GObject *source, GAsyncResult *res, gpointer data);
+
+
+static void
+DnDUriListPump(DnDUriListRead *rd)  // IN
+{
+   g_input_stream_read_bytes_async(rd->stream, DND_URI_LIST_CHUNK,
+                                   G_PRIORITY_DEFAULT, rd->cancel,
+                                   DnDUriListReadChunk, rd);
+}
+
+
+static void
+DnDUriListReadChunk(GObject *source,       // IN: the GInputStream
+                    GAsyncResult *res,     // IN
+                    gpointer data)         // IN: DnDUriListRead *
+{
+   DnDUriListRead *rd = (DnDUriListRead *) data;
+   GError *error = NULL;
+   GBytes *bytes = g_input_stream_read_bytes_finish(G_INPUT_STREAM(source),
+                                                    res, &error);
+
+   if (bytes == NULL) {
+      g_debug("%s: read failed: %s\n", __FUNCTION__,
+              error != NULL ? error->message : "unknown");
+      g_clear_error(&error);
+      DnDUriListReadFree(rd);
+      return;
+   }
+
+   gsize len = g_bytes_get_size(bytes);
+
+   if (len > 0) {
+      gsize n;
+      const char *p = (const char *) g_bytes_get_data(bytes, &n);
+
+      g_string_append_len(rd->acc, p, n);
+      g_bytes_unref(bytes);
+
+      if (rd->acc->len > DND_URI_LIST_MAX) {
+         g_warning("%s: uri list is implausibly large, giving up\n",
+                   __FUNCTION__);
+         DnDUriListReadFree(rd);
+         return;
+      }
+      DnDUriListPump(rd);
+      return;
+   }
+
+   /* Zero bytes: end of stream. */
+   g_bytes_unref(bytes);
+   g_debug("%s: got %" G_GSIZE_FORMAT " bytes of text/uri-list\n",
+           __FUNCTION__, (gsize) rd->acc->len);
+   if (rd->ui != NULL) {
+      rd->ui->ExternalUriListReady(rd->acc->str);
+   }
+   DnDUriListReadFree(rd);
+}
+
+
+static void
+DnDUriListGotStream(GObject *source,      // IN: the GdkDrop
+                    GAsyncResult *res,    // IN
+                    gpointer data)        // IN: DnDUriListRead *
+{
+   DnDUriListRead *rd = (DnDUriListRead *) data;
+   GError *error = NULL;
+   const char *mime = NULL;
+   GInputStream *stream = gdk_drop_read_finish(GDK_DROP(source), res,
+                                               &mime, &error);
+
+   if (stream == NULL) {
+      g_debug("%s: no stream: %s\n", __FUNCTION__,
+              error != NULL ? error->message : "unknown");
+      g_clear_error(&error);
+      DnDUriListReadFree(rd);
+      return;
+   }
+
+   g_debug("%s: reading drop as %s\n", __FUNCTION__,
+           mime != NULL ? mime : DRAG_TARGET_NAME_URI_LIST);
+   rd->stream = stream;
+   DnDUriListPump(rd);
+}
+
+
+/*
+ *-----------------------------------------------------------------------------
+ *
+ * DnDUIX11::StartUriListRead --
+ *
+ *      Begin fetching the dragged file list as text/uri-list.
+ *
+ *-----------------------------------------------------------------------------
+ */
+
+void
+DnDUIX11::StartUriListRead(const Glib::RefPtr< Gdk::Drop > &drop)  // IN
+{
+   static const char *mimes[] = { DRAG_TARGET_NAME_URI_LIST, NULL };
+   DnDUriListRead *rd;
+
+   /* A previous read may still be outstanding; it is stale now. */
+   CancelGHRead();
+   mGHReadCancel = g_cancellable_new();
+
+   rd = g_new0(DnDUriListRead, 1);
+   rd->ui = this;
+   rd->cancel = G_CANCELLABLE(g_object_ref(mGHReadCancel));
+   rd->acc = g_string_new(NULL);
+   mGHReads = g_slist_prepend(mGHReads, rd);
+
+   gdk_drop_read_async(drop->gobj(), (const char **) mimes,
+                       G_PRIORITY_DEFAULT, rd->cancel,
+                       DnDUriListGotStream, rd);
+}
+
+
+/*
+ *-----------------------------------------------------------------------------
+ *
+ * DnDUIX11::CancelGHRead --
+ *
+ *      Abandon any outstanding guest -> host data read.
+ *
+ *-----------------------------------------------------------------------------
+ */
+
+void
+DnDUIX11::CancelGHRead(void)
+{
+   GSList *l;
+
+   /*
+    * Detach first. A callback whose result was already queued when the cancel
+    * landed still runs, and must not reach this object once the drag is over
+    * or the object is being destroyed. Each read frees itself when its own
+    * callback fires.
+    */
+   for (l = mGHReads; l != NULL; l = l->next) {
+      ((DnDUriListRead *) l->data)->ui = NULL;
+   }
+   g_slist_free(mGHReads);
+   mGHReads = NULL;
+
+   if (mGHReadCancel != NULL) {
+      g_cancellable_cancel(mGHReadCancel);
+      g_object_unref(mGHReadCancel);
+      mGHReadCancel = NULL;
+   }
+}
