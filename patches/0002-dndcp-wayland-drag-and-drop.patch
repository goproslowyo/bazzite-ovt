+/*
+ *-----------------------------------------------------------------------------
+ *
+ * DnDUIX11::ForgetGHRead --
+ *
+ *    Drop a finished read from the live list.
+ *
+ * Results:
+ *    None.
+ *
+ * Side effects:
+ *    None.
+ *
+ *-----------------------------------------------------------------------------
+ */
+
+void
+DnDUIX11::ForgetGHRead(void *read)  // IN
+{
+   mGHReads = g_slist_remove(mGHReads, read);
+}
