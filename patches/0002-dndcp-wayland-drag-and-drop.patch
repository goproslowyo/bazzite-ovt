+/*
+ *-----------------------------------------------------------------------------
+ *
+ * DnDUIX11::ExternalUriListReady --
+ *
+ *      The uri-list arrived. Turn it into the cross-platform clipboard and
+ *      tell the host, which is what OnGtkDragDataReceived() would have done
+ *      had GTK's own preload been able to complete.
+ *
+ *-----------------------------------------------------------------------------
+ */
+
+void
+DnDUIX11::ExternalUriListReady(const char *uriList)  // IN
+{
+   std::string value(uriList != NULL ? uriList : "");
+   std::string valueType(DRAG_TARGET_NAME_URI_LIST);
+
+   if (!mGHDnDInProgress) {
+      g_debug("%s: drag already finished\n", __FUNCTION__);
+      return;
+   }
+   if (value.empty()) {
+      g_debug("%s: nothing to send\n", __FUNCTION__);
+      ResetUI();
+      return;
+   }
+   if (!SetCPClipboardFromGtk(value, valueType)) {
+      g_debug("%s: failed to set CP clipboard\n", __FUNCTION__);
+      ResetUI();
+      return;
+   }
+   if (CPClipboard_IsEmpty(&mClipboard)) {
+      g_debug("%s: clipboard came out empty\n", __FUNCTION__);
+      ResetUI();
+      return;
+   }
+   if (!mGHDnDDataReceived) {
+      g_debug("%s: drag entering, telling the host\n", __FUNCTION__);
+      mGHDnDDataReceived = true;
+      TargetDragEnter();
+   }
+}
